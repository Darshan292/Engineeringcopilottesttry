# --- OpenRouter free tier ---------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE

# Routes only within free models and picks one that supports the JSON output
# this app requires. Confirm it is still free for your key:
#   .venv/bin/python scripts/list_models.py --free
LLM_MODEL=openrouter/free

# Never spend money. See .env.example for what each layer does.
FREE_TIER_ONLY=true

# OpenRouter's free tier rations REQUESTS, not tokens: 20/minute, and 50/day
# until you have bought $10 of credit (then 1,000/day). Raise the daily figure
# only if you actually have credit.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=50

# No token ceiling on OpenRouter, so leave these at zero and let the model's
# context window be the constraint.
TOKEN_LIMIT_PER_MINUTE=0
TOKEN_LIMIT_PER_DAY=0

# Wait for the window to reopen rather than failing.
WAIT_FOR_TOKEN_BUDGET=true
MAX_TOTAL_WAIT_SECONDS=600
MAX_PLAN_SECONDS=600

# Leave GROQ_MAX_TOKENS unset so each tool keeps its own tuned output reserve.

ENABLE_TEST_EXECUTION=true
REDACTION_FAIL_CLOSED=false
HOST=127.0.0.1
PORT=8000
MAX_CONCURRENT_REQUESTS=4

# ---------------------------------------------------------------------------
# Engineering Copilot — local configuration
# Copy to .env and fill in your key:  cp .env.example .env
# ---------------------------------------------------------------------------

# Required. Free key from https://console.groq.com/keys (no credit card).
GROQ_API_KEY=gsk_replace_me

# Optional. Model ID used for every tool.
#
# NOTE: the old default `llama-3.3-70b-versatile` was DECOMMISSIONED on the
# Groq free/developer tier on 2026-08-16 and now returns 404 model_not_found.
# Groq's recommended free-tier replacements are the two below.
#
#   qwen/qwen3.6-27b      131K ctx, 16K out  <- current default
#   openai/gpt-oss-120b   131K ctx, 66K out  <- larger, also free tier
#
# Model IDs change. Hit GET /api/models while the app is running to see the
# live list straight from your own Groq account.
GROQ_MODEL=qwen/qwen3.6-27b

# Optional tuning.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=120

# Optional local server binding.
HOST=127.0.0.1
PORT=8000

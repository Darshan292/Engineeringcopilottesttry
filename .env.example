# ---------------------------------------------------------------------------
# Engineering Copilot -- local configuration
# Copy to .env and fill in your key:  cp .env.example .env
#
# NEVER paste a real key into a chat, an issue, or a screenshot. If you have,
# revoke it and issue a new one -- a leaked key is spent from your quota by
# whoever found it, and on a paid account, billed to you.
# ---------------------------------------------------------------------------

# --- provider --------------------------------------------------------------

# Which OpenAI-compatible endpoint to use: openrouter | generic.
# Leave unset and it is inferred from LLM_BASE_URL below; the default is
# openrouter, which is what this app is built around.
#
# Use `generic` for a local OpenAI-compatible server (Ollama, llama.cpp, vLLM,
# LM Studio). It assumes nothing about rationing, because assuming one vendor's
# limits for another is how you get a confusing 429.
#
# The choice changes more than the URL. OpenRouter's free tier rations REQUESTS
# (20/min, and 50/day until you have spent $10, then 1,000/day) rather than
# tokens, and states when to come back differently from most APIs -- so the app
# keeps a profile per provider in backend/providers.py.
# LLM_PROVIDER=openrouter

# --- required --------------------------------------------------------------

# Free key, no credit card: https://openrouter.ai/settings/keys
# A $0 balance is enough for the free models. LLM_API_KEY is accepted as an
# alias if you prefer a provider-neutral name.
OPENROUTER_API_KEY=sk-or-v1-replace_me

# Defaults to the provider's own endpoint, so you usually do not need this.
# Also accepts any other OpenAI-compatible server: Ollama, llama.cpp, vLLM,
# LM Studio. A loopback URL automatically bypasses any HTTP_PROXY.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional, OpenRouter only: how your app identifies itself for attribution.
# LLM_SITE_URL=https://your-site.example
# LLM_SITE_NAME=Engineering Copilot

# --- billing safety --------------------------------------------------------

# ON BY DEFAULT. Nothing is called until the provider's own price list has shown
# every one of its rates to be zero. A model that is absent from the catalogue,
# quotes no prices, or charges anything at all is refused before a socket is
# opened -- so a typo'd model id fails loudly instead of quietly costing money.
#
# Three independent layers, because any one of them can be wrong:
#   1. the price list is checked before every call
#   2. OpenRouter is sent provider.max_price = 0, so it refuses at its end too
#   3. responses report what they cost; a non-zero figure stops the process
#      and every later call is refused until it is restarted
#
# Caveat worth knowing: layer 1 only works where the provider publishes prices.
# OpenRouter does, per model, which is why the guard is built around it. Point
# LLM_BASE_URL at something that publishes none -- a local Ollama, say -- and
# only layer 3 applies. GET /api/config reports which regime is actually in
# force under "billing.mode", rather than implying a guarantee it cannot make.
#
# Setting this to false allows paid calls. Only do that deliberately.
FREE_TIER_ONLY=true

# --- model -----------------------------------------------------------------

# REQUIRED, and deliberately blank. There is no default.
#
# DO NOT TRUST ANY MODEL LIST WRITTEN HERE. OpenRouter's free variants appear
# and vanish as providers donate and withdraw capacity, so any id compiled into
# this file would eventually become a confusing 404 about a model you never
# chose. Ask your own key instead:
#
#     .venv/bin/python scripts/list_models.py --free
#
# That prints only models whose every pricing field is zero -- the same check
# the billing guard runs before each call. Copy one id below.
#
# Free ids end in ':free', e.g. 'deepseek/deepseek-chat:free'.
# 'openrouter/free' also works: it is a router that stays inside free models.
# 'openrouter/auto' is REFUSED -- it routes across paid models too.
LLM_MODEL=

# Any OpenAI-compatible endpoint works. See LLM_BASE_URL above.

# Low on purpose. These are analysis tools, and high temperature degrades
# structured-output reliability.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# LEAVE THIS UNSET unless you have a reason. Each tool reserves the output it
# actually needs (2,200 for an RCA, 3,600 for API docs), and setting this
# replaces all of them with one number for every tool. On an 8,000-token
# minute, forcing 4,096 spends half the allowance on output nobody asked for
# and is a common cause of rate limits that look like the app's fault.
# LLM_MAX_TOKENS=4096


# --- test execution --------------------------------------------------------

# The unit-test tool EXECUTES generated tests in a subprocess to verify they
# actually run. That means running model-generated code on this machine.
# It is contained (timeout, temp dir, isolated interpreter, rlimits) but it is
# not a sandbox: it does not block network or filesystem access.
#
# Set to false if you feed this untrusted input, or run the service in a
# container. With it off, generated tests are returned clearly marked as
# unverified.
ENABLE_TEST_EXECUTION=true


# --- serving ---------------------------------------------------------------

HOST=127.0.0.1
PORT=8000

# Comma-separated. Defaults to the loopback origins for the configured port.
# Never use "*" on a routable interface.
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# --- governance (all optional; defaults suit single-operator local use) -----

# REQUEST limits -- the scarce resource on OpenRouter's free tier. They default
# to the provider's own free-tier figures (20/min, 50/day), so you only need
# these to override. Raise RATE_LIMIT_PER_DAY to 1000 once you have bought $10
# of credit, which is when OpenRouter's free-model daily cap lifts.
#
# Note that ONE browser click can be many upstream calls: a split analysis is
# one call per part plus the combining rounds. The planner budgets against what
# is left today and degrades to a single call rather than spending your whole
# daily quota on one paste.
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=50

# Bounds simultaneous upstream calls, so twenty browser tabs do not become
# twenty concurrent upstream requests and a 429.
MAX_CONCURRENT_REQUESTS=4

# Shared-secret auth. Off by default (pointless on localhost); required if you
# bind to anything other than loopback. Comma-separated.
# API_TOKENS=some-long-random-token

# Restrict which models a caller may request. Empty means any.
# ALLOWED_MODELS=openrouter/free
# ALLOW_MODEL_OVERRIDE=true
# ALLOW_TEMPERATURE_OVERRIDE=true
# MAX_TEMPERATURE=1.0

# --- data-loss prevention --------------------------------------------------

# Refuse a request outright when credentials are detected, instead of redacting
# and continuing. Redaction is pattern matching; this is for material where
# "probably caught it" is not good enough.
REDACTION_FAIL_CLOSED=false

# Additional patterns for identifier shapes specific to your organisation:
# internal ticket formats, employee IDs, customer account numbers. Entries are
# NAME=<regex>, separated by ";;". An invalid regex is skipped with a warning.
# REDACTION_PATTERNS=TICKET=\bACME-[0-9]{6}\b;;EMPLOYEE_ID=\bEMP[0-9]{5}\b

# --- token budget ----------------------------------------------------------

# TOKEN limits apply only to a provider that rations tokens. OpenRouter's free
# tier does NOT -- it rations requests (see RATE_LIMIT_* above) and publishes no
# token ceiling -- so on OpenRouter these are inert and the model's full context
# window applies. They matter if you point LLM_BASE_URL at a token-rationed
# endpoint instead.
#
# Whatever you set is a CEILING: the provider's headers may lower it if your
# real allowance is smaller, but never raise it -- so pacing below your limit
# works as intended.
#
# Leave these UNSET on OpenRouter. It rations requests, not tokens, and setting
# a token ceiling there caps every call at a limit that does not exist -- which
# is how a 163,840-token model ends up reporting no room for input. Unset means
# "not rationed", and the budget then uses the model's full context window.
TOKEN_LIMIT_PER_MINUTE=8000
TOKEN_LIMIT_PER_DAY=200000


# --- pacing and coverage ---------------------------------------------------

# When a request needs more tokens than the current minute has left, wait for
# the window to roll rather than refusing. A large input genuinely takes several
# paced calls on a free tier, and a complete answer that arrives slowly is worth
# more than a fast refusal.
#
# Set to false to get an immediate 429 instead. Note that the limiter still
# accumulates usage either way -- the choice is only whether to wait.
WAIT_FOR_TOKEN_BUDGET=true

# The most one request may spend waiting on the token allowance, in total,
# across all of its calls.
MAX_TOTAL_WAIT_SECONDS=600

# How long a plan may be projected to take before the planner stops trying to
# read every line and degrades to a relevance-scored subset instead.
#
# Raising this buys coverage with time: at 8,000 tokens/minute, 600 varied log
# lines is about 13 parts and roughly seven minutes. The request is synchronous,
# so raise your reverse-proxy and gateway read timeouts to match, or the
# connection is cut before the answer arrives.
MAX_PLAN_SECONDS=600
